# Copy to .env.local and fill in. Never commit real values.

# Public URL of the deployed site (canonical URLs, sitemap, Open Graph).
# Optional on Vercel: falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend (contact form). Without a key, development logs the payload to the console instead.
RESEND_API_KEY=
# Inbox that receives contact messages.
CONTACT_TO_EMAIL=
# Verified sender, e.g. "Portfolio <contact@your-domain.com>".
CONTACT_FROM_EMAIL=

# Upstash Redis (rate limiting). Set both or neither; without them an in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Spotify "now playing" widget (optional). Set all three or none; without them the widget is hidden.
# Create an app at https://developer.spotify.com/dashboard with redirect URI http://127.0.0.1:8888/callback,
# then run: node --env-file=.env.local scripts/spotify-refresh-token.mjs
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=
